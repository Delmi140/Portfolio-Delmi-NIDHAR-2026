                </a>

                <a href="{{ path('home_page') }}#contact">
                    Contact
                </a>

            </div>

        </div>


        <!-- INFORMATIONS PERSONNELLES -->
        <div class="footer-social">

            <h3>Me retrouver</h3>

            <div class="footer-contact-info">

                <div class="footer-contact-item">

                    <i class="fa-solid fa-user"></i>

                    <span>
                        Delmi NIDHAR
                    </span>

                </div>


                <div class="footer-contact-item">

                    <i class="fa-solid fa-location-dot"></i>

                    <span>
                        80 Boulevard de Magenta<br>
                        75010 Paris, France
                    </span>

                </div>


                <div class="footer-contact-item">

                    <i class="fa-solid fa-phone"></i>

                    <span>
                        06 30 62 00 99
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- SEPARATEUR -->

    <div class="footer-separator"></div>


    <!-- FOOTER BOTTOM -->

    <div class="footer-bottom">

        <p>
            © 2026 Delmi Nidhar. Tous droits réservés.
        </p>

        <div class="footer-legal">

            <a href="{{ path('privacy_policy_page') }}">
                Politique de confidentialité
            </a>

            <a href="{{ path('legal_notice_page') }}">
