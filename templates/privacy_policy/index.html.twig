{% extends 'base.html.twig' %}

{% block title %}Politique de confidentialité | Portfolio Delmi Nidhar{% endblock %}

{% block body %}

<main class="privacy-page">

    <!-- =========================================
         HERO
    ========================================= -->

    <section class="privacy-hero">

        <div class="privacy-hero-content">

            <a
                href="{{ path('home_page') }}"
                class="privacy-logo"
                data-turbo="false"
            >
                <img
                    src="{{ asset('images/ui/logo-portfolio-dn.png') }}"
                    alt="Logo Delmi Nidhar"
                >

                <span>PORTFOLIO</span>
            </a>

            <span class="privacy-label">
                INFORMATIONS LÉGALES
            </span>

            <h1>
                Politique de confidentialité
            </h1>

            <p>
                Cette page présente les informations relatives à la
                protection des données personnelles des visiteurs de
                mon portfolio et à l'utilisation des informations
                éventuellement transmises lors d'un contact.
            </p>

        </div>

    </section>


    <!-- =========================================
         CONTENU
    ========================================= -->

    <section class="privacy-content-section">

        <div class="privacy-container">

            <!-- =========================================
                 INTRODUCTION
            ========================================= -->

            <div class="privacy-introduction">

                <p>
                    Je suis attaché au respect de votre vie privée et à
                    la protection de vos données personnelles.
                </p>

                <p>
                    La présente politique de confidentialité a pour
                    objectif de vous informer de manière claire sur les
                    données susceptibles d'être traitées lorsque vous
                    consultez mon portfolio ou lorsque vous choisissez
                    de me contacter.
                </p>

                <p>
                    Ce portfolio est un site personnel présentant mon
                    parcours, mes compétences et mes réalisations en
                    développement web.
                </p>

            </div>


            <!-- =========================================
                 01 - RESPONSABLE
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">01</span>

                <div class="privacy-card-content">

                    <h2>
                        Responsable du traitement
                    </h2>

                    <p>
                        Le responsable du traitement des données
                        personnelles éventuellement collectées dans le
                        cadre de ce site est :
                    </p>

                    <p>
                        <strong>Delmi NIDHAR</strong>
                    </p>

                    <p>
                        Adresse email :
                        <a href="mailto:nidhardelmi@hotmail.com">
                            nidhardelmi@hotmail.com
                        </a>
                    </p>

                </div>

            </article>


            <!-- =========================================
                 02 - FONCTIONNEMENT DU SITE
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">02</span>

                <div class="privacy-card-content">

                    <h2>
                        Fonctionnement du portfolio
                    </h2>

                    <p>
                        Ce site est un portfolio personnel destiné à
                        présenter mon parcours professionnel, mes
                        compétences en développement web et mes
                        différentes réalisations.
                    </p>

                    <p>
                        La consultation du portfolio ne nécessite pas
                        la création d'un compte et aucun formulaire de
                        contact n'est proposé sur le site.
                    </p>

                    <p>
                        Les visiteurs peuvent toutefois choisir de me
                        contacter directement par email à l'adresse
                        indiquée dans la rubrique Contact.
                    </p>

                </div>

            </article>


            <!-- =========================================
                 03 - DONNÉES COLLECTÉES
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">03</span>

                <div class="privacy-card-content">

                    <h2>
                        Données personnelles susceptibles d'être traitées
                    </h2>

                    <p>
                        La simple consultation des différentes sections
                        du portfolio ne nécessite pas de communiquer
                        volontairement des données personnelles telles
                        que votre nom ou votre adresse email.
                    </p>

                    <p>
                        Le site ne comporte pas de formulaire permettant
                        aux visiteurs de saisir directement leurs
                        informations personnelles.
                    </p>

                    <p>
                        Si vous choisissez de me contacter par email,
                        les informations que vous décidez de communiquer
                        dans votre message peuvent être traitées afin
                        de pouvoir répondre à votre demande.
                    </p>

                    <p>
                        Ces informations peuvent notamment comprendre
                        votre nom, votre adresse email et toute autre
                        information que vous choisissez volontairement
                        d'indiquer dans votre message.
                    </p>

                </div>

            </article>


            <!-- =========================================
                 04 - CONTACT PAR EMAIL
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">04</span>

                <div class="privacy-card-content">

                    <h2>
                        Contact par email
                    </h2>

                    <p>
                        Le portfolio permet de me contacter directement
                        par email grâce à l'adresse :
                    </p>

                    <p>
                        <a href="mailto:nidhardelmi@hotmail.com">
                            nidhardelmi@hotmail.com
                        </a>
                    </p>

                    <p>
                        Lorsque vous m'envoyez un email, les informations
                        contenues dans votre message sont utilisées afin
                        de prendre connaissance de votre demande et de
                        vous répondre.
                    </p>

                    <p>
                        Je vous invite à ne pas communiquer dans vos
                        messages des informations personnelles qui ne
                        seraient pas nécessaires à votre demande.
                    </p>

                </div>

            </article>


            <!-- =========================================
                 05 - FINALITÉ
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">05</span>

                <div class="privacy-card-content">

                    <h2>
                        Utilisation des données
                    </h2>

                    <p>
                        Les informations éventuellement communiquées
                        volontairement par email sont utilisées
                        principalement pour :
                    </p>

                    <ul class="privacy-list">

                        <li>
                            répondre aux demandes reçues par email ;
                        </li>

                        <li>
                            échanger avec les personnes qui me
                            contactent au sujet de mon portfolio,
                            de mes compétences ou de mes réalisations ;
                        </li>

                        <li>
                            assurer le suivi d'un échange lorsque cela
                            est nécessaire.
                        </li>

                    </ul>

                    <p>
                        Les informations reçues ne sont pas destinées à
                        être utilisées à des fins de prospection
                        commerciale ou de publicité de ma part.
                    </p>

                </div>

            </article>


            <!-- =========================================
                 06 - DESTINATAIRES
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">06</span>

                <div class="privacy-card-content">

                    <h2>
                        Destinataires des données
                    </h2>

                    <p>
                        Les informations que vous choisissez de
                        transmettre par email sont destinées à
                        <strong>Delmi NIDHAR</strong> dans le cadre du
                        traitement de votre demande.
                    </p>

                    <p>
                        Elles ne sont pas destinées à être vendues,
                        louées ou communiquées à des fins commerciales.
                    </p>

                    <p>
                        Elles peuvent toutefois être communiquées à une
                        autorité compétente lorsque cette communication
                        est imposée par une obligation légale.
                    </p>

                </div>

            </article>


            <!-- =========================================
                 07 - CONSERVATION
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">07</span>

                <div class="privacy-card-content">

                    <h2>
                        Durée de conservation
                    </h2>

                    <p>
                        Les informations éventuellement reçues par email
                        sont conservées pendant la durée nécessaire au
                        traitement et au suivi de la demande, puis
                        supprimées lorsqu'elles ne sont plus nécessaires,
                        sous réserve des obligations légales pouvant
                        imposer une durée de conservation particulière.
                    </p>

                    <p>
                        Le portfolio lui-même ne nécessite pas la création
                        d'un compte utilisateur.
                    </p>

                </div>

            </article>


            <!-- =========================================
                 08 - VOS DROITS
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">08</span>

                <div class="privacy-card-content">

                    <h2>
                        Vos droits
                    </h2>

                    <p>
                        Conformément à la réglementation applicable en
                        matière de protection des données personnelles,
                        vous disposez notamment, lorsque les conditions
                        légales sont réunies, de droits d'accès, de
                        rectification, d'effacement, de limitation et
                        d'opposition au traitement de vos données.
                    </p>

                    <p>
                        Vous pouvez également demander des informations
                        concernant le traitement de vos données
                        personnelles.
                    </p>

                    <p>
                        Pour exercer vos droits ou pour toute question
                        relative à la protection de vos données, vous
                        pouvez me contacter par email à l'adresse :
                    </p>

                    <p>
                        <a href="mailto:nidhardelmi@hotmail.com">
                            nidhardelmi@hotmail.com
                        </a>
                    </p>

                </div>

            </article>


            <!-- =========================================
                09 - COOKIES ET TRACEURS
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">09</span>

                <div class="privacy-card-content">

                    <h2>
                        Cookies et traceurs
                    </h2>

                    <p>
                        Le portfolio n'utilise actuellement pas de cookies ou de
                        traceurs destinés à analyser votre navigation, à effectuer
                        du suivi publicitaire ou à établir un profil des visiteurs.
                    </p>

                    <p>
                        Aucun outil de mesure d'audience ou de publicité nécessitant
                        le dépôt de cookies n'est actuellement utilisé sur le site.
                    </p>

                    <p>
                        Les ressources techniques utilisées pour le fonctionnement
                        ou l'affichage du portfolio peuvent toutefois être chargées
                        depuis des services externes. Ces ressources ne constituent
                        pas, à elles seules, un système de suivi publicitaire ou
                        statistique mis en place par le portfolio.
                    </p>

                    <p>
                        Le site ne demande donc actuellement aucun consentement
                        spécifique pour des cookies non nécessaires.
                    </p>

                    <p>
                        Si l'utilisation de cookies ou de traceurs soumis au
                        consentement venait à être mise en place ultérieurement,
                        cette politique serait mise à jour et un dispositif
                        permettant de recueillir votre consentement serait ajouté
                        lorsque cela serait nécessaire.
                    </p>

                </div>

            </article>

            <!-- =========================================
                 10 - SERVICES ET CONTENUS EXTERNES
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">10</span>

                <div class="privacy-card-content">

                    <h2>
                        Services et contenus externes
                    </h2>

                    <p>
                        Certaines ressources techniques utilisées par le
                        portfolio peuvent être chargées depuis des
                        services externes, notamment pour assurer le
                        fonctionnement ou l'affichage du site.
                    </p>

                    <p>
                        Le portfolio peut également contenir des liens
                        permettant d'accéder à des services ou plateformes
                        externes, notamment GitHub, utilisés pour présenter
                        certaines de mes réalisations.
                    </p>

                    <p>
                        Lorsque vous quittez mon portfolio pour accéder à
                        un service externe, les règles de confidentialité
                        et les conditions d'utilisation de ce service
                        s'appliquent.
                    </p>

                </div>

            </article>


            <!-- =========================================
                 11 - MISE À JOUR
            ========================================= -->

            <article class="privacy-card">

                <span class="privacy-number">11</span>

                <div class="privacy-card-content">

                    <h2>
                        Mise à jour de la politique
                    </h2>

                    <p>
                        Cette politique de confidentialité peut être
                        mise à jour lorsque cela est nécessaire afin de
                        tenir compte de l'évolution du portfolio, de ses
                        fonctionnalités ou de la réglementation
                        applicable.
                    </p>

                    <p>
                        La version publiée sur cette page est la version
                        applicable au moment de votre consultation.
                    </p>

                </div>

            </article>


            <!-- =========================================
                 RETOUR
            ========================================= -->

            <div class="privacy-back">

                <a
                    href="{{ path('home_page') }}"
                    class="privacy-back-button"
                    data-turbo="false"
                >
                    <i class="fa-solid fa-arrow-left"></i>
                    Retour à l'accueil
                </a>

            </div>

        </div>

    </section>

</main>


<!-- =========================================
     FOOTER
========================================= -->

<footer class="portfolio-footer">

    <div class="footer-container">

        <!-- BRAND -->

        <div class="footer-brand">

            <a
                href="{{ path('home_page') }}"
                class="footer-logo"
                data-turbo="false"
            >
                <img
                    src="{{ asset('images/ui/logo-portfolio-dn.png') }}"
                    alt="Logo Delmi Nidhar"
                >

                <span>PORTFOLIO</span>
            </a>

            <p class="footer-description">
                Développeur Web Full Stack Junior,
                passionné par la création d'expériences
