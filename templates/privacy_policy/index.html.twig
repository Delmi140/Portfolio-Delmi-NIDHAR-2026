                </a>

                <a href="{{ path('home_page') }}#competences">
                    Compétences
                </a>

                <a href="{{ path('home_page') }}#realisations">
                    Réalisations
                </a>

                <a href="{{ path('home_page') }}#contact">
                    Contact
                </a>

            </div>

        </div>


        <!-- INFORMATIONS PERSONNELLES -->

        <div class="footer-social">

            <h3>Me retrouver</h3>

            <div class="footer-contact-info">

                <div class="footer-contact-item">

                    <i class="fa-solid fa-user"></i>

                    <span>
                        Delmi NIDHAR
                    </span>

                </div>


                <div class="footer-contact-item">

                    <i class="fa-solid fa-location-dot"></i>

                    <span>
                        80 Boulevard de Magenta<br>
                        75010 Paris, France
                    </span>

                </div>


                <div class="footer-contact-item">

                    <i class="fa-solid fa-phone"></i>

                    <span>
