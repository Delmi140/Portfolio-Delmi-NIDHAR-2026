                class="footer-logo"
                data-turbo="false"
            >
                <img
                    src="{{ asset('images/ui/logo-portfolio-dn.png') }}"
                    alt="Logo Delmi Nidhar"
                >

                <span>PORTFOLIO</span>
            </a>

            <p class="footer-description">
                Développeur Web Full Stack Junior,
                passionné par la création d'expériences
                numériques modernes et fonctionnelles.
            </p>

        </div>


        <!-- NAVIGATION -->
        <div class="footer-navigation">

            <h3>Navigation</h3>

            <div class="footer-links">

                <a href="{{ path('home_page') }}#about">
                    À propos
                </a>

                <a href="{{ path('home_page') }}#competences">
