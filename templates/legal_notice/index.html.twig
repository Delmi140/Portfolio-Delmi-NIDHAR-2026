                        </a>
                    </p>

                    <p>
                        Adresse postale :
                        80 Boulevard de Magenta,
                        75010 Paris, France.
                    </p>

                </div>

            </article>


            <!-- =========================================
                 02 - HÉBERGEMENT
            ========================================= -->

            <article class="legal-card">

                <span class="legal-number">
                    02
                </span>

                <div class="legal-card-content">

                    <h2>
                        Hébergement du site
                    </h2>

